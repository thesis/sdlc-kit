{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.+__save_document$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/document-gate.mjs\"", "timeout": 300 }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/document-gate.mjs\"", "timeout": 300 }
        ]
      }
    ]
  }
}
